; The brief installer, for Inno Setup 6.3 or newer. After bundle.sh, CI runs:
;   iscc /DBundle=<abs path>\dist\brief /DAppVersion=0.1.0 /O<abs path>\dist packaging\windows\brief.iss
; Per user by default (no admin, %LOCALAPPDATA%\Programs\brief); "Install for all users" in the
; first dialog, or /ALLUSERS, asks for admin and goes to Program Files.
; Silent: brief-<version>-setup-x86_64.exe /VERYSILENT /CURRENTUSER [/MERGETASKS="desktopicon,mailto"]

#ifndef Bundle
  #define Bundle "..\..\dist\brief"
#endif
; the version embedded in brief.exe, which build.rs takes from Cargo.toml
#ifndef AppVersion
  #define AppVersion GetStringFileInfo(AddBackslash(Bundle) + "brief.exe", "ProductVersion")
#endif
; VersionInfoVersion wants plain numbers: 0.2.0-rc1 -> 0.2.0
#if Pos("-", AppVersion) > 0
  #define NumVersion Copy(AppVersion, 1, Pos("-", AppVersion) - 1)
#else
  #define NumVersion AppVersion
#endif
#define AppExe "brief.exe"
#define Repo "https://github.com/elyesghazel/brief"

[Setup]
; never change the AppId: upgrades and the uninstaller find an installed brief by it
AppId={{4822F902-BA9C-45C5-B369-23435B7AD0E7}
AppName=brief
AppVersion={#AppVersion}
AppVerName=brief {#AppVersion}
AppPublisher=Elyes Ghazel
AppPublisherURL={#Repo}
AppSupportURL={#Repo}/issues
AppUpdatesURL={#Repo}/releases
AppCopyright=Copyright (c) 2026 Elyes Ghazel
VersionInfoVersion={#NumVersion}
VersionInfoProductTextVersion={#AppVersion}
VersionInfoCompany=Elyes Ghazel
VersionInfoDescription=brief setup
DefaultDirName={autopf}\brief
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog commandline
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0
OutputDir=..\..\dist
OutputBaseFilename=brief-{#AppVersion}-setup-x86_64
SetupIconFile=..\..\assets\logo\brief.ico
UninstallDisplayIcon={app}\{#AppExe}
UninstallDisplayName=brief
WizardStyle=modern
; generated by assets/logo/build.py, at 100, 150 and 200 % scaling
WizardImageFile=wizard\large-164x314.bmp,wizard\large-246x459.bmp,wizard\large-328x628.bmp
WizardSmallImageFile=wizard\small-55x55.bmp,wizard\small-83x80.bmp,wizard\small-110x106.bmp
Compression=lzma2/ultra64
SolidCompression=yes
LZMAUseSeparateProcess=yes
ChangesAssociations=yes
CloseApplications=yes
SetupLogging=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "mailto"; Description: "Offer brief for mailto: links (then pick it in Settings > Apps > Default apps)"; GroupDescription: "Mail links:"; Flags: unchecked

[InstallDelete]
; an upgrade replaces GTK as a whole, so DLLs and data the new version no longer ships do not linger
Type: filesandordirs; Name: "{app}\lib"
Type: filesandordirs; Name: "{app}\share"
Type: files; Name: "{app}\*.dll"

[Files]
Source: "{#Bundle}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\brief"; Filename: "{app}\{#AppExe}"; Comment: "Keyboard-first mail"
Name: "{autodesktop}\brief"; Filename: "{app}\{#AppExe}"; Comment: "Keyboard-first mail"; Tasks: desktopicon

[Registry]
; Win+R "brief"
Root: HKA; Subkey: "Software\Microsoft\Windows\CurrentVersion\App Paths\{#AppExe}"; ValueType: string; ValueName: ""; ValueData: "{app}\{#AppExe}"; Flags: uninsdeletekey
; mailto: brief registers as a candidate only; Windows lets the user, not an installer, pick the default
Root: HKA; Subkey: "Software\Classes\brief.mailto"; ValueType: string; ValueName: ""; ValueData: "brief mail link"; Flags: uninsdeletekey; Tasks: mailto
Root: HKA; Subkey: "Software\Classes\brief.mailto"; ValueType: string; ValueName: "URL Protocol"; ValueData: ""; Tasks: mailto
Root: HKA; Subkey: "Software\Classes\brief.mailto\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: """{app}\{#AppExe}"",0"; Tasks: mailto
Root: HKA; Subkey: "Software\Classes\brief.mailto\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#AppExe}"" ""%1"""; Tasks: mailto
Root: HKA; Subkey: "Software\Clients\Mail\brief"; ValueType: string; ValueName: ""; ValueData: "brief"; Flags: uninsdeletekey; Tasks: mailto
Root: HKA; Subkey: "Software\Clients\Mail\brief\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#AppExe}"""; Tasks: mailto
Root: HKA; Subkey: "Software\Clients\Mail\brief\Capabilities"; ValueType: string; ValueName: "ApplicationName"; ValueData: "brief"; Tasks: mailto
Root: HKA; Subkey: "Software\Clients\Mail\brief\Capabilities"; ValueType: string; ValueName: "ApplicationDescription"; ValueData: "Keyboard-first mail"; Tasks: mailto
Root: HKA; Subkey: "Software\Clients\Mail\brief\Capabilities"; ValueType: string; ValueName: "ApplicationIcon"; ValueData: """{app}\{#AppExe}"",0"; Tasks: mailto
Root: HKA; Subkey: "Software\Clients\Mail\brief\Capabilities\URLAssociations"; ValueType: string; ValueName: "mailto"; ValueData: "brief.mailto"; Tasks: mailto
Root: HKA; Subkey: "Software\RegisteredApplications"; ValueType: string; ValueName: "brief"; ValueData: "Software\Clients\Mail\brief\Capabilities"; Flags: uninsdeletevalue; Tasks: mailto

[Run]
Filename: "{app}\{#AppExe}"; Description: "{cm:LaunchProgram,brief}"; Flags: nowait postinstall skipifsilent

[Code]
function RegRoot: Integer;
begin
  if IsAdminInstallMode then Result := HKLM else Result := HKCU;
end;

// an upgrade that unticks "mailto" takes the registration back
procedure CurStepChanged(CurStep: TSetupStep);
begin
  if (CurStep = ssPostInstall) and not WizardIsTaskSelected('mailto') then
  begin
    RegDeleteKeyIncludingSubkeys(RegRoot, 'Software\Classes\brief.mailto');
    RegDeleteKeyIncludingSubkeys(RegRoot, 'Software\Clients\Mail\brief');
    RegDeleteValue(RegRoot, 'Software\RegisteredApplications', 'brief');
  end;
end;

// The config and the mail cache stay unless the user says otherwise; silent uninstalls keep them.
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  Config, Cache: String;
begin
  if (CurUninstallStep <> usPostUninstall) or UninstallSilent then Exit;
  Config := ExpandConstant('{userappdata}\brief');
  Cache := ExpandConstant('{localappdata}\brief');
  if not DirExists(Config) and not DirExists(Cache) then Exit;
  if MsgBox('Also delete your brief settings and mail cache?' + #13#10#13#10 +
      Config + #13#10 + Cache + #13#10#13#10 +
      'Choose No to keep them for a later install. Saved passwords stay in the Windows ' +
      'Credential Manager either way (entries starting with brief).',
      mbConfirmation, MB_YESNO or MB_DEFBUTTON2) = IDYES then
  begin
    DelTree(Config, True, True, True);
    DelTree(Cache, True, True, True);
  end;
end;
